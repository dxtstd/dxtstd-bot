{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "allowJs": false,
    "checkJs": false,
    "strict": false,
    "noImplicitThis": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "lib",
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src/**/*.ts", "src/Commands/*.ts", "src/Plugins/*.ts"],
  "exclude": ["node_modules", "assets", "database", "tmp"]
}
